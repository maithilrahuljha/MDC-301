# Copy to .env and replace both placeholder secrets with fresh, different values.
# For class use on a trusted local network: COOKIE_SECURE=false and TRUST_PROXY=false.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-different-long-random-secret
SESSION_CODE=MDC301W1
# Select the in-class quiz: quiz1 (Q1–Q8) or quiz2 (Q9–Q20).
QUIZ_ID=quiz1
PORT=8000
DATABASE_PATH=data/responses.sqlite3
COOKIE_SECURE=false
TRUST_PROXY=false
SOCKETIO_ASYNC_MODE=gevent
