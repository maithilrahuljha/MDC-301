# Copy this file to .env and replace the two placeholder secrets with fresh values.
# Local LAN: COOKIE_SECURE=false. Behind Caddy/HTTPS on a VPS: COOKIE_SECURE=true.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-different-long-random-secret
SESSION_CODE=MDC301W1
# Set one topic slug from topic_banks/ to run a 10-question topic test.
# Set to all to use the original daily question bank filtered by QUIZ_DAY.
QUIZ_TOPIC=all
QUIZ_DAY=1
PORT=8000
DATABASE_PATH=data/responses.sqlite3
COOKIE_SECURE=false
TRUST_PROXY=false
SOCKETIO_ASYNC_MODE=gevent
